# Backend only. Supabase injects its database/service credentials automatically.
# Public mode is deliberately disabled until the Phase 4 pilot is ready.
REVIEW_PUBLIC_ENABLED=false
REVIEW_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Use a real secret for public mode; never put this in public-config.js.
# The protected development preview defaults to Cloudflare's test secret when unset.
# TURNSTILE_SECRET_KEY=replace_with_real_server_secret_before_launch
# Final release origin (origin only, without the repository path):
# REVIEW_ALLOWED_ORIGINS=https://mariustalpos.github.io
# Enable REVIEW_PUBLIC_ENABLED only after real Turnstile setup and launch approval.
