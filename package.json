{
  "name": "buhurt-vendor-directory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:photos": "node scripts/build-photos.mjs",
    "build:reviews": "node scripts/build-reviews.mjs",
    "preview:reviews": "node scripts/prepare-review-preview.mjs",
    "test:reviews:browser": "node scripts/test-submission-browser.mjs",
    "test:reviews:hosted": "node scripts/test-submission-hosted.mjs",
